  "policy": {
    "schema": "rampq.gate1.ignore_geometry_policy/v1",
    "scope": "synthetic_geometry_and_ragged_collation_primitives_only",
    "chain": [
      "explicit_actual_loader_resize",
      "same_sampled_centered_letterbox",
      "same_sampled_vertical_horizontal_flip"
    ],
    "letterbox": {
      "auto": false,
      "scale_fill": false,
      "center": true
    },
    "forbidden": [
      "mosaic",
      "mixup",
      "cutmix",
      "copy_paste",
      "random_perspective",
      "rotation",
      "shear",
      "translation",
      "random_scale_crop",
      "spatial_albumentations",
      "multi_scale"
    ],
    "publisher_sources_separate": [
      "score_0",
      "category_0",
      "category_11"
    ],
    "empty_or_nonpositive_publisher_geometry": "reject_entire_sample_for_explicit_quarantine_never_silent_drop",
    "quality_excluded_positive": "reject_separate_policy_required_never_convert_to_publisher_ignore",
    "geometry": "clipped_final_canvas_pixel_xyxy",
    "inside": "x1 <= anchor_x < x2 and y1 <= anchor_y < y2",
    "positive_priority": "downstream_loss_keeps_all_channels_of_TAL_positive_anchors",
    "official_training_or_AP_rule": false,
    "training_pipeline_integrated": false
  },
  "restricted_options": {
    "pipeline": "explicit_loader_letterbox_flip_v1",
    "mosaic": 0.0,
    "mixup": 0.0,
    "cutmix": 0.0,
    "copy_paste": 0.0,
    "degrees": 0.0,
    "translate": 0.0,
    "scale": 0.0,
    "shear": 0.0,
    "perspective": 0.0,
    "spatial_albumentations": false,
    "multi_scale": false,
    "letterbox_auto": false,
    "letterbox_scale_fill": false,
    "letterbox_center": true
  },
  "source_findings": [
    {
      "source": "prepare_gate1_visdrone.py:161-204",
      "finding": "Publisher score=0/category0/11 and preparation-quality exclusions are distinguishable; both may be present in ignored sidecars."
    },
    {
      "source": "data/base.py:267-280",
      "finding": "Actual loader resize applies separate ceil-rounded pixel dimensions. Sidecar uses both actual output ratios."
    },
    {
      "source": "data/augment.py:1729-1778,1836-1887",
      "finding": "LetterBox has public get_params/apply_instances; ratio and integer pad are reused exactly by synthetic geometry."
    },
    {
      "source": "data/augment.py:1532-1593",
      "finding": "RandomFlip has sampled decision plus absolute/normalized dimensions; this primitive requires the absolute canvas dimensions."
    },
    {
      "source": "data/augment.py:2809-2855",
      "finding": "Ordinary v8_transforms composes affine and other operations even when selected mix probabilities are zero; a new explicit chain must be built."
    },
    {
      "source": "data/dataset.py:409-438",
      "finding": "Existing collate behavior does not itself transform ignore geometry or validate its identity; custom sidecar collation here is not installed into Dataset."
    }
  ],
